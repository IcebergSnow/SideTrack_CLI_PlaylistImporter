# Optional environment variables. The CLI does not load .env files automatically.
# Export these in your shell, or use --client-secrets and --config-dir instead.
# Keep real credentials outside the repository; never paste tokens into chat.
PLAYLIST_IMPORTER_CLIENT_SECRETS=/absolute/path/to/client_secret.json
PLAYLIST_IMPORTER_CONFIG_DIR=/absolute/path/to/private/config/directory
